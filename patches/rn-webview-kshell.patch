+        val view = viewWrapper.webView
+        viewWrapper.kimiThemeScript?.remove()
+        viewWrapper.kimiThemeScript = null
+        view.injectedJSBeforeContentLoaded = value
+        if (value == null) return
+        val header = value.substringBefore('\n')
+        val prefix = "// kshell-kimi-document-theme:"
+        val end = "\n// kshell-kimi-theme-end\n"
+        if (!header.startsWith(prefix) || !value.contains(end)) return
+        val color = header.removePrefix(prefix)
+        if (!Regex("#[0-9a-fA-F]{6}").matches(color)) return
+
+        // The WebView itself must stay TRANSPARENT (upstream RNCWebViewWrapper
+        // behavior). Making it opaque reintroduces the OEM white flash: the
+        // renderer's empty-document frames during slow navigations paint white
+        // regardless of setBackgroundColor. The wrapper carries the theme color
+        // instead, so unpainted frames composite over the dark container.
+        viewWrapper.setBackgroundColor(android.graphics.Color.parseColor(color))
+        if (WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {
+            viewWrapper.kimiThemeScript = androidx.webkit.WebViewCompat.addDocumentStartJavaScript(
+                view,
+                value.substringAfter('\n').substringBefore(end),
+                setOf("https://code-rc.kimi.com", "https://code-rc.kimi.ai"),
+            )
+            // Keep the regular bridge and topbar on the existing callback.
+            view.injectedJSBeforeContentLoaded = value.substringAfter(end)
+        }
     }
