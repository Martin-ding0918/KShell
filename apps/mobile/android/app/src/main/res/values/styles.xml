<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Window background follows the day/night scheme (values-night):
             with edge-to-edge inset padding it shows through the status/nav
             bar areas, so it must match the app's background color. Bar icon
             contrast is set at runtime in MainActivity.applySystemBars. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

</resources>
