{
  "name": "zcode-shell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=12"
  },
  "description": "Kimi Code and ZCode remote-control shell for Android",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "@react-native/gradle-plugin@0.82.1": "patches/rn-gradle-plugin-drop-foojay.patch",
    "react-native-webview@13.17.0": "patches/rn-webview-kshell.patch",
    "react-native-camera-kit@18.0.1": "patches/rn-camera-kit-zxing.patch"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
